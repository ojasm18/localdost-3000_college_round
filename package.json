{
  "name": "patchwork",
  "private": true,
  "workspaces": ["server", "web"],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "seed": "tsx server/src/seed.ts",
    "reset": "node -e \"try{require('fs').unlinkSync('./patchwork.db')}catch(e){}\" && npm run seed",
    "test": "vitest run"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "esbuild": "^0.20.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^1.2.0"
  }
}
